{
  "name": "@spine-ts/proto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Spine TS generated Protobuf-ES schema exports.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./generated/*": {
      "types": "./dist/generated/*.d.ts",
      "default": "./dist/generated/*.js"
    },
    "./generated/*.js": {
      "types": "./dist/generated/*.d.ts",
      "default": "./dist/generated/*.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1"
  }
}
