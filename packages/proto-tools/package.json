{
  "name": "@spine-event-engine/proto-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Safe deterministic manifest tooling for Spine Proto model packages.",
  "bin": {
    "spine-proto": "./dist/src/cli/spine-proto.js"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "prepack": "node scripts/clean-dist.mjs && tsc -b"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "scripts/clean-dist.mjs"
  ],
  "dependencies": {
    "@spine-event-engine/server": "0.0.0",
    "@bufbuild/buf": "1.71.0",
    "@bufbuild/protoc-gen-es": "2.12.1",
    "@bufbuild/protobuf": "2.12.1",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@types/semver": "7.7.1"
  }
}
