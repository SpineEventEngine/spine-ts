{
  "name": "@spine-event-engine/proto-tools",
  "version": "2.0.0-snapshot.3",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpineEventEngine/spine-ts",
    "directory": "packages/proto-tools"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "snapshot"
  },
  "description": "Safe deterministic manifest tooling for Spine Proto model packages.",
  "bin": {
    "spine-proto": "./bin/spine-proto.mjs"
  },
  "scripts": {
    "build": "tsc -b && pnpm run copy:runtime",
    "clean": "node scripts/clean-dist.mjs",
    "copy:runtime": "node scripts/copy-runtime-modules.mjs",
    "prepack": "node scripts/clean-dist.mjs && pnpm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing/index.d.ts",
      "default": "./dist/src/testing/index.js"
    }
  },
  "files": [
    "bin/spine-proto.mjs",
    "dist",
    "scripts/clean-dist.mjs",
    "scripts/copy-runtime-modules.mjs",
    "README.md",
    "REFERENCE.md"
  ],
  "dependencies": {
    "@spine-event-engine/proto": "2.0.0-snapshot.2",
    "@bufbuild/buf": "1.71.0",
    "@bufbuild/protoc-gen-es": "2.12.1",
    "@bufbuild/protobuf": "2.12.1",
    "@bufbuild/protoplugin": "2.12.1",
    "semver": "7.8.5",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/semver": "7.7.1"
  }
}
