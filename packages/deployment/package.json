{
  "name": "@spine-event-engine/deployment",
  "version": "2.0.0-snapshot.7",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpineEventEngine/spine-ts",
    "directory": "packages/deployment"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "description": "Platform-neutral application-node discovery for Spine gateways.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./spi/backend-membership": {
      "types": "./dist/spi/backend-membership.d.ts",
      "default": "./dist/spi/backend-membership.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "REFERENCE.md"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@spine-event-engine/proto": "workspace:*",
    "@spine-event-engine/storage": "workspace:*",
    "loglayer": "9.4.0"
  },
  "devDependencies": {
    "@spine-event-engine/storage-datastore": "workspace:*",
    "@spine-event-engine/storage-rdbms": "workspace:*",
    "mysql2": "3.23.1"
  }
}
