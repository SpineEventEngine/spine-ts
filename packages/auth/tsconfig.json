{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "lib": ["ES2024", "DOM", "decorators"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "node_modules/bun-types/sqlite.d.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    { "path": "../core" },
    { "path": "../deployment" },
    { "path": "../proto" },
    { "path": "../storage" }
  ]
}
