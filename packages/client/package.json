{
  "name": "@spine-ts/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Spine TS client-side Projection metadata and query foundations.",
  "bin": {
    "protoc-gen-spine-projection-columns": "./codegen/generate-projection-columns.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "default": "./dist/codegen/index.js"
    }
  },
  "files": [
    "codegen",
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@spine-ts/server": "workspace:*"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@bufbuild/protoplugin": "2.12.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@spine-ts/core": "workspace:*",
    "@spine-ts/proto": "workspace:*"
  }
}
