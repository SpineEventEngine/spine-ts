{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2024", "DOM", "decorators"],
    "types": ["node"],
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    { "path": "../auth" },
    { "path": "../core" },
    { "path": "../proto" },
    { "path": "../storage" },
    { "path": "../transport" }
  ]
}
