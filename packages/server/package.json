{
  "name": "@spine-event-engine/server",
  "version": "2.0.0-snapshot.2",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpineEventEngine/spine-ts",
    "directory": "packages/server"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "snapshot"
  },
  "description": "Spine TS server runtime metadata and assembly package.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./internal/generated-handler-registry": {
      "types": "./dist/handler/generated-handler-registry.d.ts",
      "default": "./dist/handler/generated-handler-registry.js"
    },
    "./internal/handler-codegen": {
      "types": "./dist/handler/handler-codegen.d.ts",
      "default": "./dist/handler/handler-codegen.js"
    },
    "./internal/conditional-pickup": {
      "types": "./dist/delivery/conditional-pickup.d.ts",
      "default": "./dist/delivery/conditional-pickup.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "REFERENCE.md"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@spine-event-engine/auth": "2.0.0-snapshot.2",
    "@spine-event-engine/core": "2.0.0-snapshot.2",
    "@spine-event-engine/deployment": "2.0.0-snapshot.2",
    "@spine-event-engine/proto": "2.0.0-snapshot.2",
    "@spine-event-engine/storage": "2.0.0-snapshot.2",
    "@spine-event-engine/transport": "2.0.0-snapshot.2",
    "loglayer": "9.4.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@spine-event-engine/storage-datastore": "2.0.0-snapshot.2",
    "@spine-event-engine/storage-rdbms": "2.0.0-snapshot.2",
    "@connectrpc/connect-web": "2.1.2"
  },
  "scripts": {
    "test:stand-registry:providers": "node scripts/test-stand-registry-providers.mjs"
  }
}
