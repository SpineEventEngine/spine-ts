{
  "name": "@spine-ts/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Spine TS server runtime metadata and assembly package.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal/generated-handler-registry": {
      "types": "./dist/handler/generated-handler-registry.d.ts",
      "default": "./dist/handler/generated-handler-registry.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@spine-ts/core": "workspace:*",
    "@spine-ts/proto": "workspace:*",
    "@spine-ts/storage": "workspace:*",
    "@spine-ts/transport": "workspace:*"
  }
}
