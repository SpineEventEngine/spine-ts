{
  "name": "@spine-event-engine/server",
  "version": "2.0.0-snapshot.8",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpineEventEngine/spine-ts",
    "directory": "packages/server"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "description": "Spine TS server runtime metadata and assembly package.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./spi/handler-registry": {
      "types": "./dist/spi/handler-registry.d.ts",
      "default": "./dist/spi/handler-registry.js"
    },
    "./spi/delivery": {
      "types": "./dist/spi/delivery.d.ts",
      "default": "./dist/spi/delivery.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "REFERENCE.md"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@spine-event-engine/core": "2.0.0-snapshot.7",
    "@spine-event-engine/deployment": "2.0.0-snapshot.7",
    "@spine-event-engine/proto": "2.0.0-snapshot.7",
    "@spine-event-engine/storage": "2.0.0-snapshot.7",
    "@spine-event-engine/transport": "2.0.0-snapshot.7",
    "loglayer": "9.4.0"
  },
  "peerDependencies": {
    "@spine-event-engine/auth": "2.0.0-snapshot.7"
  },
  "peerDependenciesMeta": {
    "@spine-event-engine/auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@spine-event-engine/storage-datastore": "2.0.0-snapshot.7",
    "@spine-event-engine/storage-rdbms": "2.0.0-snapshot.7",
    "@connectrpc/connect-web": "2.1.2",
    "@spine-event-engine/delivery-server": "workspace:*",
    "@spine-event-engine/delivery-client": "workspace:*",
    "@spine-event-engine/example-todo": "workspace:*",
    "@spine-event-engine/proto-tools": "workspace:*",
    "@google-cloud/datastore": "10.1.1",
    "mysql2": "3.23.1"
  },
  "scripts": {
    "test:stand-registry:providers": "node scripts/test-stand-registry-providers.mjs"
  }
}
