{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vitest"],
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "packages/*/examples/**/*.ts",
    "packages/*/examples/**/*.tsx",
    "examples/*/src/**/*.ts",
    "examples/*/src/**/*.tsx",
    "examples/*/test/**/*.ts",
    "examples/*/test/**/*.tsx",
    "examples/*/*/src/**/*.ts",
    "examples/*/*/src/**/*.tsx",
    "examples/*/*/test/**/*.ts",
    "examples/*/*/test/**/*.tsx",
    "examples/*/*/vite.config.ts",
    "examples/*/playwright.config.ts",
    "vitest.config.ts",
    "vitest.infrastructure.config.ts"
  ]
}
