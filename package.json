{
  "name": "spine-ts",
  "version": "2.0.0-snapshot.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "typecheck": "pnpm proto:generate && pnpm typecheck:generated",
    "typecheck:generated": "pnpm typecheck:build:generated && pnpm typecheck:tooling",
    "typecheck:build": "pnpm proto:generate && pnpm typecheck:build:generated",
    "typecheck:build:generated": "node scripts/clean-build-outputs.mjs && tsc -b && pnpm --dir packages/proto-tools run copy:runtime && node scripts/normalize-generated-declarations.mjs",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.eslint.json",
    "lint": "pnpm proto:generate && pnpm lint:generated && pnpm lint:copyright",
    "lint:generated": "pnpm typecheck:build:generated && eslint . && node scripts/check-cleanup-rules.mjs && node scripts/check-tsdoc.mjs",
    "format:check": "node scripts/format-files.mjs --check",
    "format": "node scripts/format-files.mjs --write",
    "test": "pnpm proto:generate && pnpm test:generated",
    "test:generated": "pnpm typecheck:build:generated && vitest run --passWithNoTests",
    "test:coverage": "pnpm proto:generate && pnpm test:coverage:generated",
    "test:coverage:generated": "pnpm typecheck:build:generated && vitest run --coverage --passWithNoTests",
    "images:build:local": "node examples/message-board/deploy/container/build-local-images.mjs",
    "test:images:local": "node --test examples/message-board/deploy/container/build-context-cleanup.test.mjs examples/message-board/deploy/container/image-contract.test.mjs",
    "test:compatibility:jvm": "pnpm check:node && pnpm exec vitest run compatibility-tests/jvm/fixture.test.mjs && node --test compatibility-tests/jvm/wire-compatibility.test.mjs",
    "test:envoy": "node --test interop/envoy/render.test.mjs interop/envoy/validate.test.mjs",
    "docs:api": "pnpm proto:generate && pnpm docs:api:generated",
    "docs:api:generated": "typedoc --options typedoc.json",
    "docs:api:check": "node scripts/check-api-docs.mjs",
    "docs:audience:check": "node scripts/check-doc-audience.mjs",
    "docs:snippets:check": "pnpm typecheck:build && pnpm docs:snippets:check:generated",
    "docs:snippets:check:generated": "node docs/check-typescript-snippets.mjs",
    "docs:check": "pnpm proto:generate && pnpm typecheck:build:generated && pnpm docs:check:generated",
    "docs:check:generated": "pnpm docs:api:check && pnpm docs:audience:check && pnpm docs:snippets:check:generated",
    "proto:verify": "node scripts/verify-proto-sources.mjs",
    "proto:lint": "node scripts/proto-workflow.mjs lint",
    "proto:lint:generated": "pnpm exec buf lint",
    "proto:generate": "node scripts/proto-workflow.mjs generate",
    "proto:check-generated": "node scripts/check-generated-clean.mjs",
    "proto:check-generated:current": "node scripts/check-generated-clean.mjs --current-output",
    "check:release-readiness": "node scripts/check-release-readiness.mjs",
    "verify": "pnpm verify:release",
    "verify:task": "pnpm check:node && node scripts/verify-task.mjs",
    "lint:cleanup": "node scripts/check-cleanup-rules.mjs",
    "check:t0212-removed-routing": "node scripts/check-t0212-removed-routing.mjs",
    "lint:tsdoc": "node scripts/check-tsdoc.mjs",
    "check:logging-containment": "node scripts/check-log-containment.mjs",
    "check:production-dependencies": "node scripts/check-production-dependencies.mjs",
    "audit:release": "pnpm audit --audit-level=low && pnpm audit --prod --audit-level=low",
    "verify:generated-gates": "pnpm typecheck:build:generated && pnpm typecheck:tooling && eslint . && pnpm lint:cleanup && pnpm lint:tsdoc && pnpm lint:copyright && pnpm format:check && pnpm docs:check:generated && pnpm proto:lint:generated && pnpm proto:check-generated:current && pnpm check:logging-containment && pnpm check:production-dependencies && pnpm check:release-readiness",
    "verify:release": "pnpm check:node && pnpm proto:generate && pnpm verify:release:generated",
    "verify:release:generated": "pnpm verify:generated-gates && vitest run --coverage --passWithNoTests --testTimeout=15000 --maxWorkers=1",
    "verify:publish": "pnpm verify:release && pnpm audit:release",
    "verify:generated": "pnpm verify:release:generated",
    "lint:copyright": "node scripts/check-copyright.mjs"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.71.0",
    "@bufbuild/protoc-gen-es": "2.12.1",
    "@bufbuild/protoplugin": "2.12.1",
    "@eslint/js": "9.39.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.0",
    "lerna": "10.0.1",
    "prettier": "3.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.9",
    "yaml": "2.9.0"
  }
}
