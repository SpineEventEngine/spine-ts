{
  "name": "spine-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "typecheck": "pnpm proto:generate && pnpm typecheck:generated",
    "typecheck:generated": "pnpm typecheck:build:generated && pnpm typecheck:tooling",
    "typecheck:build": "pnpm proto:generate && pnpm typecheck:build:generated",
    "typecheck:build:generated": "node scripts/clean-delivery-client-dist.mjs && tsc -b",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.eslint.json",
    "lint": "pnpm proto:generate && pnpm lint:generated",
    "lint:generated": "pnpm typecheck:build:generated && eslint . && node scripts/check-cleanup-rules.mjs",
    "format:check": "node scripts/format-files.mjs --check",
    "format": "node scripts/format-files.mjs --write",
    "test": "pnpm proto:generate && pnpm test:generated",
    "test:generated": "pnpm typecheck:build:generated && vitest run --passWithNoTests",
    "test:coverage": "pnpm proto:generate && pnpm test:coverage:generated",
    "test:coverage:generated": "pnpm typecheck:build:generated && vitest run --coverage --passWithNoTests",
    "docs:api": "pnpm proto:generate && pnpm docs:api:generated",
    "docs:api:generated": "typedoc --options typedoc.json",
    "docs:check": "pnpm proto:generate && pnpm docs:check:generated",
    "docs:check:generated": "typedoc --options typedoc.json && node scripts/check-api-docs.mjs",
    "proto:verify": "node scripts/verify-proto-sources.mjs",
    "proto:lint": "node scripts/proto-workflow.mjs lint",
    "proto:generate": "node scripts/proto-workflow.mjs generate",
    "proto:check-generated": "node scripts/check-generated-clean.mjs",
    "check:release-readiness": "node scripts/check-release-readiness.mjs",
    "verify": "pnpm check:node && pnpm proto:generate && pnpm verify:generated",
    "verify:generated": "pnpm typecheck:generated && pnpm lint:generated && pnpm format:check && pnpm test:generated && pnpm test:coverage:generated && pnpm docs:check:generated && pnpm proto:lint && pnpm proto:check-generated && pnpm check:release-readiness"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.71.0",
    "@bufbuild/protoc-gen-es": "2.12.1",
    "@bufbuild/protoplugin": "2.12.1",
    "@eslint/js": "9.39.1",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.0",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.9"
  }
}
