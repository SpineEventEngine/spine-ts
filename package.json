{
  "name": "spine-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "typecheck": "pnpm typecheck:build && pnpm typecheck:tooling",
    "typecheck:build": "pnpm proto:generate && tsc -b",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.eslint.json",
    "lint": "pnpm typecheck:build && eslint . && node scripts/check-cleanup-rules.mjs",
    "format:check": "prettier --check \"*.{json,md,yaml,yml,mjs,ts}\" \".*.json\" \"docs/**/*.md\" \"packages/**/*.{json,md,ts}\" \"examples/**/*.{json,md,ts}\" \"proto/**/*.md\" \"scripts/**/*.mjs\" \"build-protocol/**/*.md\"",
    "format": "prettier --write \"*.{json,md,yaml,yml,mjs,ts}\" \".*.json\" \"docs/**/*.md\" \"packages/**/*.{json,md,ts}\" \"examples/**/*.{json,md,ts}\" \"proto/**/*.md\" \"scripts/**/*.mjs\" \"build-protocol/**/*.md\"",
    "test": "pnpm typecheck:build && vitest run --passWithNoTests",
    "test:coverage": "pnpm typecheck:build && vitest run --coverage --passWithNoTests",
    "docs:api": "pnpm proto:generate && typedoc --options typedoc.json",
    "docs:check": "pnpm proto:generate && typedoc --options typedoc.json && node scripts/check-api-docs.mjs",
    "proto:verify": "node scripts/verify-proto-sources.mjs",
    "proto:lint": "node scripts/proto-workflow.mjs lint",
    "proto:generate": "node scripts/proto-workflow.mjs generate",
    "proto:check-generated": "node scripts/check-generated-clean.mjs",
    "verify": "pnpm check:node && pnpm proto:generate && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:coverage && pnpm docs:check && pnpm proto:lint && pnpm proto:generate && pnpm proto:check-generated"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.71.0",
    "@bufbuild/protoc-gen-es": "2.12.1",
    "@eslint/js": "9.39.1",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.0",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.9"
  }
}
