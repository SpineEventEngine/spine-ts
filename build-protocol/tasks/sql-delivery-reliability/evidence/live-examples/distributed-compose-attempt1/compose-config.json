{
  "name": "sqlrel-compose-1014",
  "networks": {
    "default": {
      "name": "sqlrel-compose-1014_default",
      "ipam": {}
    }
  },
  "services": {
    "application-node-1": {
      "command": [
        "node_modules/@spine-event-engine/example-message-board-app/dist/src/multi-process-app.js"
      ],
      "depends_on": {
        "datastore": {
          "condition": "service_healthy",
          "required": true
        },
        "delivery": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "DATASTORE_EMULATOR_HOST": "datastore:8081",
        "DATASTORE_PROJECT_ID": "distributed-message-board",
        "DELIVERY_SERVER_URL": "http://delivery:8484",
        "DELIVERY_SHARD_COUNT": "2",
        "HOST": "0.0.0.0",
        "NODE_ENV": "production",
        "PORT": "8080",
        "PROCESS_COUNT": "2"
      },
      "image": "spine-ts/message-board:sqlrel-compose-1014",
      "networks": {
        "default": null
      }
    },
    "application-node-2": {
      "command": [
        "node_modules/@spine-event-engine/example-message-board-app/dist/src/multi-process-app.js"
      ],
      "depends_on": {
        "datastore": {
          "condition": "service_healthy",
          "required": true
        },
        "delivery": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "DATASTORE_EMULATOR_HOST": "datastore:8081",
        "DATASTORE_PROJECT_ID": "distributed-message-board",
        "DELIVERY_SERVER_URL": "http://delivery:8484",
        "DELIVERY_SHARD_COUNT": "2",
        "HOST": "0.0.0.0",
        "NODE_ENV": "production",
        "PORT": "8080",
        "PROCESS_COUNT": "2"
      },
      "image": "spine-ts/message-board:sqlrel-compose-1014",
      "networks": {
        "default": null
      }
    },
    "datastore": {
      "command": [
        "gcloud",
        "emulators",
        "firestore",
        "start",
        "--database-mode=datastore-mode",
        "--host-port=0.0.0.0:8081",
        "--quiet"
      ],
      "entrypoint": null,
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "bash -c 'echo \u003e /dev/tcp/127.0.0.1/8081'"
        ],
        "timeout": "2s",
        "interval": "2s",
        "retries": 30
      },
      "image": "google/cloud-sdk:578.0.0-emulators",
      "networks": {
        "default": null
      }
    },
    "delivery": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "HOST": "0.0.0.0",
        "PORT": "8484"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "node -e \"const client=require('node:http2').connect('http://127.0.0.1:8484');client.on('connect',()=\u003e{client.close();process.exit(0)});client.on('error',()=\u003eprocess.exit(1));setTimeout(()=\u003eprocess.exit(1),1000)\""
        ],
        "timeout": "2s",
        "interval": "2s",
        "retries": 30
      },
      "image": "spine-ts/simple-delivery-server:sqlrel-compose-1014",
      "networks": {
        "default": null
      }
    },
    "gateway": {
      "command": null,
      "depends_on": {
        "application-node-1": {
          "condition": "service_started",
          "required": true
        },
        "application-node-2": {
          "condition": "service_started",
          "required": true
        },
        "datastore": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "BACKEND_URLS": "http://application-node-1:8080,http://application-node-2:8080",
        "BROWSER_ORIGIN": "http://127.0.0.1:25280",
        "DATASTORE_EMULATOR_HOST": "datastore:8081",
        "DATASTORE_PROJECT_ID": "distributed-message-board",
        "HOST": "0.0.0.0",
        "NODE_ENV": "production",
        "PORT": "8080"
      },
      "image": "spine-ts/standalone-gateway:sqlrel-compose-1014",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8080,
          "published": "28180",
          "protocol": "tcp"
        }
      ]
    }
  }
}