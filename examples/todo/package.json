{
  "name": "@spine-ts/example-todo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runnable server-side to-do example for Spine TS.",
  "scripts": {
    "start": "node dist/src/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "USER_GUIDE.md"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@spine-ts/core": "workspace:*",
    "@spine-ts/proto": "workspace:*",
    "@spine-ts/server": "workspace:*"
  },
  "devDependencies": {
    "@spine-ts/testing": "workspace:*",
    "@spine-ts/transport": "workspace:*"
  }
}
