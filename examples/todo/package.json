{
  "name": "@spine-event-engine/example-todo",
  "version": "2.0.0-snapshot.1",
  "private": true,
  "type": "module",
  "description": "Runnable server-side to-do example for Spine TS.",
  "scripts": {
    "start": "pnpm -C ../.. typecheck:build && bash scripts/run-single-process.sh",
    "start:single-process": "bash scripts/run-single-process.sh",
    "start:multi-process": "bash scripts/run-multi-process.sh",
    "smoke": "node scripts/smoke.mjs",
    "proto:generate": "spine-proto generate",
    "clean:generated-dist": "node scripts/clean-generated-dist.mjs",
    "prepack": "pnpm clean:generated-dist && tsc -b"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./spine-proto-manifest.json": "./spine-proto-manifest.json",
    "./proto/*": "./proto/*",
    "./generated/*.js": {
      "types": "./dist/generated/*.d.ts",
      "default": "./dist/generated/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "USER_GUIDE.md",
    "proto",
    "spine-proto.json",
    "spine-proto-manifest.json"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@spine-event-engine/client-node": "workspace:*",
    "@spine-event-engine/core": "workspace:*",
    "@spine-event-engine/delivery-client": "workspace:*",
    "@spine-event-engine/proto": "2.0.0-snapshot.1",
    "@spine-event-engine/server": "workspace:*",
    "@spine-event-engine/storage": "workspace:*",
    "@spine-event-engine/storage-datastore": "workspace:*",
    "@google-cloud/datastore": "10.1.1"
  },
  "devDependencies": {
    "@spine-event-engine/proto-tools": "2.0.0-snapshot.1",
    "@spine-event-engine/testing": "workspace:*"
  }
}
