{
  "name": "@spine-event-engine/example-message-board-model",
  "version": "2.0.0-snapshot.8",
  "private": true,
  "type": "module",
  "scripts": {
    "proto:generate": "spine-proto generate",
    "clean:generated-dist": "node scripts/clean-generated-dist.mjs",
    "prepack": "pnpm clean:generated-dist && tsc -b"
  },
  "exports": {
    ".": {
      "types": "./dist/generated/proto-module.d.ts",
      "default": "./dist/generated/proto-module.js"
    },
    "./spine-proto-manifest.json": "./spine-proto-manifest.json",
    "./proto/*": "./proto/*",
    "./generated/*.js": {
      "types": "./dist/generated/*.d.ts",
      "default": "./dist/generated/*.js"
    }
  },
  "files": [
    "dist",
    "proto",
    "scripts",
    "spine-proto.json",
    "spine-proto-manifest.json"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@spine-event-engine/proto": "2.0.0-snapshot.8",
    "@spine-event-engine/core": "2.0.0-snapshot.8"
  },
  "devDependencies": {
    "@spine-event-engine/proto-tools": "2.0.0-snapshot.8"
  }
}
