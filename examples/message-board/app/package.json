      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "spine-proto.json"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@spine-event-engine/example-message-board-model": "2.0.0-snapshot.1",
    "@spine-event-engine/auth": "workspace:*",
    "@spine-event-engine/client-node": "workspace:*",
    "@spine-event-engine/core": "2.0.0-snapshot.1",
    "@spine-event-engine/proto": "2.0.0-snapshot.1",
    "@spine-event-engine/server": "2.0.0-snapshot.1",
    "@spine-event-engine/storage": "workspace:*"
  },
  "devDependencies": {
    "@spine-event-engine/proto-tools": "2.0.0-snapshot.1"
  }
}
