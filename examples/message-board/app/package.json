{
  "name": "@spine-event-engine/example-message-board-app",
  "version": "2.0.0-snapshot.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/src/local-entry.js",
    "start:application": "node dist/src/application-server.js",
    "start:multi-process": "node dist/src/multi-process-app.js",
    "start:combined": "node dist/src/combined-server.js",
    "proto:compose": "spine-proto compose",
    "handlers:generate": "spine-proto handlers",
    "prepack": "pnpm handlers:generate && tsc -b"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "spine-proto.json"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@google-cloud/datastore": "10.1.1",
    "@google-cloud/logging": "12.0.0",
    "@loglayer/transport-google-cloud-logging": "3.3.0",
    "@spine-event-engine/auth": "2.0.0-snapshot.1",
    "@spine-event-engine/client-node": "2.0.0-snapshot.1",
    "@spine-event-engine/core": "2.0.0-snapshot.1",
    "@spine-event-engine/delivery-client": "2.0.0-snapshot.1",
    "@spine-event-engine/deployment-gke": "2.0.0-snapshot.1",
    "@spine-event-engine/example-message-board-model": "2.0.0-snapshot.1",
    "@spine-event-engine/proto": "2.0.0-snapshot.1",
    "@spine-event-engine/server": "2.0.0-snapshot.1",
    "@spine-event-engine/storage": "2.0.0-snapshot.1",
    "@spine-event-engine/storage-datastore": "2.0.0-snapshot.1",
    "loglayer": "9.4.0"
  },
  "devDependencies": {
    "@spine-event-engine/proto-tools": "2.0.0-snapshot.1"
  }
}
