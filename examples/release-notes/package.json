    "@radix-ui/react-tabs": "1.1.22",
    "@spine-event-engine/ai": "workspace:*",
    "@spine-event-engine/ai-vercel-ax": "workspace:*",
    "@spine-event-engine/client-node": "workspace:*",
    "@spine-event-engine/core": "workspace:*",
    "@spine-event-engine/proto": "2.0.0-snapshot.24",
    "@spine-event-engine/server": "workspace:*",
    "@spine-event-engine/storage": "workspace:*",
    "@mobrowser/api": "2.18.0",
