{
  "name": "@spine-event-engine/example-release-notes",
  "version": "2.0.0-snapshot.25",
  "private": true,
  "type": "module",
  "exports": {
    "./spine-proto-manifest.json": "./spine-proto-manifest.json",
    "./proto/*": "./proto/*",
    "./generated/*.js": {
      "types": "./dist/generated/*.d.ts",
      "default": "./dist/generated/*.js"
    }
  },
  "scripts": {
    "build": "pnpm dev:build",
    "dev:build": "pnpm prepare:studio && mobrowser dev:build",
