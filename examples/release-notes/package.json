    "dev": "pnpm prepare:studio && mobrowser dev",
    "test:e2e": "pnpm prepare:studio && mobrowser test:e2e",
    "prepare:studio": "pnpm gen:desktop && pnpm build:main-source && pnpm build:worker && pnpm prepare:node",
    "gen:desktop": "mobrowser gen",
    "build:worker": "node scripts/build-worker.mjs",
    "build:main-source": "node scripts/build-main-source.mjs",
    "prepare:node": "node scripts/prepare-node.mjs",
    "mobrowser": "mobrowser"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect": "2.1.2",
    "@modelcontextprotocol/server": "2.3.1",
