{
  "name": "@spine-event-engine/example-datastore-orders",
  "version": "2.0.0-snapshot.29",
  "private": true,
  "type": "module",
  "scripts": {
    "load": "pnpm -C ../.. typecheck:build && node dist/scripts/load.mjs",
    "postgres:load": "pnpm -C ../.. typecheck:build && node dist/scripts/postgres-load.mjs",
    "datastore:load": "pnpm -C ../.. typecheck:build && node dist/scripts/datastore-load.mjs",
    "test:postgres": "pnpm -C ../.. typecheck:build && pnpm exec vitest --root ../.. --config vitest.infrastructure.config.ts run examples/orders/test/postgres-live.test.ts --testTimeout=15000",
    "test:datastore": "pnpm -C ../.. typecheck:build && pnpm exec vitest --root ../.. --config vitest.infrastructure.config.ts run examples/orders/test/datastore-live.test.ts",
    "proto:generate": "spine-proto generate",
    "clean:generated-dist": "node scripts/clean-generated-dist.mjs",
    "prepack": "pnpm clean:generated-dist && tsc -b"
  },
  "exports": {
    "./spine": {
      "types": "./dist/generated/spine-metadata.d.ts",
      "default": "./dist/generated/spine-metadata.js"
    },
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./spine-proto-manifest.json": "./spine-proto-manifest.json",
    "./proto/*": "./proto/*",
    "./generated/*.js": {
      "types": "./dist/generated/*.d.ts",
      "default": "./dist/generated/*.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "proto",
    "spine-proto.json",
    "spine-proto-manifest.json",
    "README.md"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@google-cloud/datastore": "10.1.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@spine-event-engine/client-node": "workspace:*",
    "@spine-event-engine/core": "workspace:*",
    "@spine-event-engine/proto": "2.0.0-snapshot.29",
    "@spine-event-engine/server": "workspace:*",
    "@spine-event-engine/storage": "workspace:*",
    "@spine-event-engine/storage-datastore": "workspace:*",
    "@spine-event-engine/storage-postgres": "workspace:*"
  },
  "devDependencies": {
    "@spine-event-engine/proto-tools": "2.0.0-snapshot.29"
  }
}
