{
	admin off
	auto_https disable_redirects
	log {
		level ERROR
		format filter {
			request>uri delete
			request>headers delete
		}
	}
	servers {
		protocols h1 h2
	}
}

{$FIELDNOTES_PUBLIC_ORIGIN} {
	bind {$FIELDNOTES_BIND_ADDRESS}
	tls {$FIELDNOTES_TLS_CERT} {$FIELDNOTES_TLS_KEY}
	reverse_proxy {$FIELDNOTES_NEXT_ADDRESS}
}
