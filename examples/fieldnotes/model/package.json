{
  "name": "@spine-event-engine/example-fieldnotes-model",
  "version": "2.0.0-snapshot.29",
  "private": true,
  "type": "module",
  "scripts": {
    "proto:generate": "spine-proto generate",
    "prepack": "tsc -b"
  },
  "exports": {
    "./spine": {
      "types": "./dist/generated/spine-metadata.d.ts",
      "default": "./dist/generated/spine-metadata.js"
    },
    ".": {
      "types": "./dist/generated/proto-module.d.ts",
      "default": "./dist/generated/proto-module.js"
    },
    "./spine-proto-manifest.json": "./spine-proto-manifest.json",
    "./proto/*": "./proto/*",
    "./generated/*.js": {
      "types": "./dist/generated/*.d.ts",
      "default": "./dist/generated/*.js"
    }
  },
  "files": [
    "dist",
    "proto",
    "spine-proto.json",
    "spine-proto-manifest.json"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@spine-event-engine/proto": "2.0.0-snapshot.28",
    "@spine-event-engine/core": "2.0.0-snapshot.28"
  },
  "devDependencies": {
    "@spine-event-engine/proto-tools": "2.0.0-snapshot.28"
  }
}
